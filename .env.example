ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SQLAlchemy database URL.
# Leave as SQLite for local dev; switch to PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/specforge
DATABASE_URL=sqlite:///./data/specforge.db

# Claude model for API calls
ANTHROPIC_MODEL=claude-sonnet-4-6

# Set to true to enable LLM-assisted compound sentence splitting (requires API key)
USE_LLM_SEGMENTATION=false

# Base URL for the FastAPI backend (used by the Streamlit dashboard)
API_BASE_URL=http://localhost:8000
