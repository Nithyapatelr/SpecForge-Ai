FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y git nodejs npm && rm -rf /var/lib/apt/lists/*

# Clone MetaGPT at stable tag v0.8.1
RUN git clone --branch v0.8.1 https://github.com/geekan/MetaGPT.git /app/MetaGPT

WORKDIR /app/MetaGPT

RUN pip install --no-cache-dir -e .

ENTRYPOINT ["metagpt"]
